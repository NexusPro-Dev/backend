# Variables de entorno de NEXUS backend.
#
# Este archivo SE VERSIONA y NO contiene valores reales (Art. IX.3, IV.3).
# Copiar a .env y completar. El archivo .env está excluido por .gitignore.
#
# La aplicación falla al arrancar si falta una variable obligatoria: no asume
# valores por defecto inseguros (Art. IX.5).
#
# ESTE ARCHIVO ES PARA LOCAL. El valor que va en cada variable en un entorno
# desplegado —y las trampas propias de la plataforma— están en
# `docs/deployment.md` §6. Dos avisos que se pagan caro al confundirlos:
#
#   - Los `$` del hash de abajo van DUPLICADOS AQUÍ y TAL CUAL en Railway.
#     El problema es de la interpolación de Docker Compose, no del hash.
#   - `CORS_ALLOWED_ORIGINS` con `localhost` vale aquí y en ningún otro sitio.

# ---------- Entorno ----------
# development | testing | production  (Art. IX.4)
#
# OBLIGATORIA Y SIN VALOR POR DEFECTO: si falta, o si trae algo que no sea uno
# de esos tres, LA APLICACIÓN NO ARRANCA (Art. IX.5). No se compara como texto
# suelto a propósito — de ella depende que no se siembren datos de prueba, y
# con una cadena libre `Production`, `prod` y el vacío contarían todos como
# «no es producción».
#
# QUÉ CAMBIA SEGÚN EL VALOR, hoy: fuera de `production` se aplica al arrancar
# la semilla de `db/dev-seed/` — quince personas de prueba que comparten el
# hash del superadministrador y no tienen cambio de contraseña obligatorio.
ENVIRONMENT=development

# Semilla de datos de prueba. En `production` NO se aplica nunca, lo diga esto
# lo que diga. Se apaga solo para la suite, que cuenta personas y roles.
DEV_SEED_ENABLED=true

# ---------- Base de datos ----------
# PostgreSQL es el único motor admitido (Art. V.1)
DATABASE_URL=jdbc:postgresql://localhost:5432/nexus
DATABASE_USER=
DATABASE_PASSWORD=

# ---------- Seguridad ----------
# Secreto de firma del token de acceso. Sin valor por defecto en ningún
# entorno (security.md §5.2). Generar uno distinto por entorno.
JWT_SECRET=

# Orígenes autorizados para llamar desde el navegador (CORS), separados por
# coma y con la forma esquema://host[:puerto] — sin barra final y sin ruta.
#
#   local        http://localhost:5173,http://localhost:3000
#   desplegado   https://app.nexus.co
#
# Vacío = ningún origen autorizado. Es lo seguro y no rompe nada que no sea un
# navegador: quien consume la API de servidor a servidor no pasa por CORS.
#
# El comodín `*` NO se admite y la aplicación FALLA AL ARRANCAR con él: abriría
# la API al navegador de cualquiera. Tampoco se admite un origen sin esquema
# (`localhost:5173`) ni con barra final, porque no casarían nunca y el fallo
# aparecería como un error de CORS en el navegador y no aquí.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Cuánto puede el navegador reutilizar la comprobación previa antes de
# repetirla. Por defecto PT30M; media hora ahorra un viaje por petición sin
# retrasar de más un cambio de política.
CORS_MAX_AGE=PT30M

# ---------- API ----------
API_URL=http://localhost:8080

# Expone /swagger-ui.html y /v3/api-docs sin autenticar. Por defecto false:
# el contrato describe cada endpoint y cada permiso del sistema. Solo en
# desarrollo debe ir en true.
EXPOSE_API_DOCS=true

# ---------- Operación ----------
LOG_LEVEL=INFO

# Límite de tasa de los endpoints públicos de autenticación (security.md §5.5).
# Se apaga SOLO para pruebas de otros requerimientos, que emiten ráfagas contra
# el login a propósito. En un entorno desplegado no debería tocarse.
#
# La cuenta vive en memoria del proceso: el límite es POR INSTANCIA. Es una de
# las tres razones por las que el despliegue corre con una sola réplica
# (`docs/deployment.md` §2.1).
RATE_LIMIT_ENABLED=true

# Retención del registro de peticiones, en días (Art. XV.8).
# Pendiente de fijar: decisión D-10.
REQUEST_LOG_RETENTION_DAYS=

# Lista de proxies confiables, separados por coma. De ella depende la validez
# de la IP registrada en la auditoria (Art. V.15). Vacio = no hay proxy y se
# usa la IP del socket.
#
# Cada entrada es una direccion o un BLOQUE CIDR: 10.0.0.1, 10.0.0.0/8,
# fd00::/8. El bloque es lo que permite declarar la red privada de un
# proveedor cuya IP de borde no es fija. Confiar en un rango es confiar en
# TODO lo que salga de el, asi que se declara el mas estrecho posible.
#
# Una entrada que no se entienda TUMBA EL ARRANQUE (Art. IX.5): ignorarla
# dejaria un despliegue que cree tener configurada la confianza y no la tiene.
#
# El valor de cada entorno sigue pendiente: decision D-21.
TRUSTED_PROXIES=

# Purga de sesiones caducadas (issue #25). Se apaga solo para pruebas: sin
# ella, `refresh_tokens` crece de forma monótona con el uso, porque cada
# refresco rota el token y revocar es marcar y no eliminar.
TOKEN_PURGE_ENABLED=true
# Cron de seis campos, en UTC. De madrugada: nada de esto urge.
TOKEN_PURGE_CRON=0 30 3 * * *
# Cuánto se espera DESPUÉS de que la familia entera caduque. Purgar demasiado
# pronto apaga la detección de robo por reutilización de `RF-SP-035`, que vive
# precisamente en las filas revocadas.
TOKEN_PURGE_RETENTION=P30D


# ---------- Superadministrador inicial ----------
# Los siembra `V22__seed_superadmin.sql` por marcador de posición de Flyway.
# Ninguna de las dos tiene valor por defecto: un despliegue que no las declare
# FALLA AL ARRANCAR, en lugar de arrancar con una credencial conocida
# (Art. IX.5). `docker-compose.yml` fija el correo para local; quien use
# `mvn spring-boot:run` debe declarar las dos aquí.
SUPERADMIN_EMAIL=

# Contraseña del Super Usuario, ya hasheada con Argon2id.
#
# ATENCIÓN — LOS `$` VAN DUPLICADOS EN ESTE ARCHIVO.
#
# Docker Compose interpola los valores del `.env`, de modo que cada `$algo`
# del hash se expande como una variable inexistente y desaparece. Un hash
# pegado tal cual llega al contenedor convertido en basura, la migración
# TERMINA CON ÉXITO, y el superadministrador simplemente no puede entrar
# nunca — con un mensaje genérico de credenciales inválidas.
#
#   hash real     $argon2id$v=19$m=16384,t=2,p=1$c29tZXNhbHQ$abc...
#   aquí se pone  $$argon2id$$v=19$$m=16384,t=2,p=1$$c29tZXNhbHQ$$abc...
#
# Comprobación rápida: `docker compose config | grep SUPERADMIN_PASSWORD_HASH`
# debe devolver el hash completo. Si salen trozos sueltos, faltan los `$$`.
#
# Por variable de entorno del proceso NO hace falta duplicar nada: el problema
# es exclusivo de este archivo.
SUPERADMIN_PASSWORD_HASH=

# ---------------------------------------------------------------------------
# Envío saliente — Resend (RF-SP-040, architecture.md §15.1, D-23)
# ---------------------------------------------------------------------------
#
# APAGADO por defecto, y a propósito: sin credencial la aplicación arranca y
# avisa en el log en lugar de fallar la primera vez que alguien olvide su
# contraseña — que es cuando nadie está mirando. Con esto en `false`, la
# recuperación emite permisos que NADIE RECIBE.
NOTIFICATION_ENABLED=false

# Clave del API de Resend, `re_...`.
RESEND_API_KEY=

# Remitente. DEBE pertenecer a un dominio verificado en Resend, o el proveedor
# rechaza el envío con un 403 que no se descubre hasta producción.
# Ejemplo: NEXUS <no-responder@factech.co>
NOTIFICATION_FROM=

# Plantilla con estilos de cada correo. El valor es el id o el ALIAS de una
# plantilla PUBLICADA en Resend; el alias es preferible, porque sobrevive a
# recrearla.
#
# VACÍO manda el correo en TEXTO PLANO, que es el respaldo deliberado: sin
# plantilla el mensaje sale sin estilos en lugar de no salir. Si se pone un
# valor que no existe, Resend rechaza el envío y el correo SÍ se pierde.
#
# Para la recuperación de contraseña (RF-SP-040). Añadir otra plantilla es
# añadir su variable aquí y una línea en `application.yml`.
NOTIFICATION_TEMPLATE_PASSWORD_RECOVERY=nexus-password-recovery
