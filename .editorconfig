# Formato base para cualquier editor. El formato del código Java lo aplica
# Spotless (development-guide.md §6.1); esto solo evita que un editor
# introduzca diferencias antes de llegar ahí.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
# En Markdown, dos espacios al final fuerzan un salto de línea
trim_trailing_whitespace = false

[*.sql]
indent_size = 4

[Makefile]
indent_style = tab
